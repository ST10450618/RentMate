<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 12+ (API 31+).
   The Room cache (rentmate.db) holds household money data and is rebuilt from
   Supabase after sign-in, so it is excluded from cloud backup and device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="rentmate.db" />
        <exclude domain="database" path="rentmate.db-wal" />
        <exclude domain="database" path="rentmate.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="rentmate.db" />
        <exclude domain="database" path="rentmate.db-wal" />
        <exclude domain="database" path="rentmate.db-shm" />
    </device-transfer>
</data-extraction-rules>
